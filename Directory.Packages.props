  </ItemGroup>
  <ItemGroup>
    <GlobalPackageReference Include="Microsoft.Build.CopyOnWrite" Version="1.0.334" />
    <GlobalPackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
    <GlobalPackageReference Include="StyleCop.Analyzers" Version="1.3.180" />
  </ItemGroup>
</Project>